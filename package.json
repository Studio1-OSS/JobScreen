{
  "name": "jobscreen",
  "version": "0.1.0",
  "description": "Open-source resume scoring that shows its work: rank applicants from any ATS export, or get your resume score for a job before you apply. DeepSeek V4.1 Flash 1017 vision on Nebius Token Factory, built with Mastra.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Studio1-OSS/jobscreen.git"
  },
  "keywords": [
    "resume-score",
    "ats",
    "ats-resume-checker",
    "resume-checker",
    "resume-ranking",
    "recruiting",
    "job-seekers",
    "mastra",
    "nebius",
    "deepseek",
    "vision",
    "nextjs"
  ],
  "scripts": {
    "dev": "next dev --turbopack -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "typecheck": "tsc --noEmit",
    "smoke:nebius": "tsx scripts/nebius-smoke.mts",
    "fixtures": "tsx scripts/make-fixtures.mts",
    "bench": "tsx scripts/bench.mts",
    "bench:fetch": "tsx bench/fetch.mts",
    "bench:50": "tsx bench/run.mts",
    "test": "vitest run",
    "bench:fit": "tsx bench/fit.mts",
    "demo:test": "tsx scripts/record-demo.mts",
    "demo:record": "tsx scripts/record-demo.mts --record"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.70",
    "@mastra/core": "^1.78.0",
    "@octokit/rest": "^22.0.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.60.0",
    "mammoth": "^1.13.0",
    "motion": "^14.5.0",
    "next": "16.4.1",
    "pdfjs-dist": "^6.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "tldts": "^7.4.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^16.5.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "1.56.1",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@napi-rs/canvas",
      "sharp"
    ]
  }
}
