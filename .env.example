# Nebius Token Factory: https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.us-north1.nebius.com/v1/
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# Strongly recommended on any public deployment: every API call must send this key.
# Reviewers enter it once in the browser.
JOBSCREEN_ACCESS_KEY=

# Optional: raises the GitHub API limit from 60 to 5,000 requests an hour (needed for big batches)
GITHUB_TOKEN=

# Optional: set to 0 to turn off reasoning in the scorer (faster, slightly less consistent)
SCORER_THINKING=1

# Optional: the public URL, used for social preview images
NEXT_PUBLIC_SITE_URL=
